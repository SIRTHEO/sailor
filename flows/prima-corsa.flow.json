{
  "id": "prima-corsa",
  "description": "Il flusso più piccolo che esista: una verifica sola. Serve a provare che un flusso dichiarato in un file arriva fino in fondo — caricato, validato, eseguito, depositato — senza che nessuno scriva codice nuovo.",
  "graph": {
    "steps": [
      {
        "id": "working-tree-is-clean",
        "deps": [],
        "action": "shell_check",
        "max_attempts": 1,
        "when": null,
        "input_schema": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "env": {
              "type": "object",
              "properties": {},
              "required": [],
              "allow_extra": true
            },
            "timeout_secs": { "type": "number" }
          },
          "required": ["command", "env", "timeout_secs"],
          "allow_extra": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": ["passed", "failed", "timed_out"]
            }
          },
          "required": ["status"],
          "allow_extra": false
        }
      }
    ],
    "skippable_dependencies": []
  },
  "inputs": {
    "working-tree-is-clean": {
      "command": "test -z \"$(git -C \"$HOME/personal/sailor\" status --porcelain)\"",
      "env": {},
      "timeout_secs": 30
    }
  }
}
