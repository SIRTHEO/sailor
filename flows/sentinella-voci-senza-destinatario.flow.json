{
  "id": "sentinella-voci-senza-destinatario",
  "description": "Lavorazione ogni-notte, peso leggero: invoca codex e poi verifica il risultato.",
  "schedule": {
    "recurrence": { "kind": "daily_at", "hour": 1, "minute": 0 },
    "weight": "light",
    "perimeter": []
  },
  "graph": {
    "steps": [
      {
        "id": "motore",
        "deps": [],
        "action": "external_engine",
        "max_attempts": 1,
        "when": null,
        "input_schema": {
          "type": "object",
          "properties": {
            "bin": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "properties": {},
              "required": [],
              "allow_extra": true
            },
            "timeout_secs": {
              "type": "number"
            }
          },
          "required": [
            "bin",
            "args",
            "env",
            "timeout_secs"
          ],
          "allow_extra": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "ok",
                "exit_error",
                "timed_out",
                "spawn_failed"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "stdout",
            "stderr"
          ],
          "allow_extra": false
        }
      },
      {
        "id": "verifica",
        "deps": [
          "motore"
        ],
        "action": "shell_check",
        "max_attempts": 1,
        "when": {
          "kind": "pointer_equals",
          "pointer": "/status",
          "value": "ok"
        },
        "with": {
          "command": "tot=$(ls -1 \"$HOME\"/.claude/state/plancia/segnalazioni/*.md 2>/dev/null | wc -l | tr -d ' '); con=$(grep -l '^destinatario:' \"$HOME\"/.claude/state/plancia/segnalazioni/*.md 2>/dev/null | wc -l | tr -d ' '); real=$((tot - con)); [ \"$real\" -le 200 ]",
          "timeout_secs": 120
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "ok",
                "exit_error",
                "timed_out",
                "spawn_failed"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "timeout_secs": {
              "type": "number"
            }
          },
          "required": [
            "status",
            "stdout",
            "stderr",
            "command",
            "timeout_secs"
          ],
          "allow_extra": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "passed",
                "failed",
                "timed_out"
              ]
            }
          },
          "required": [
            "status"
          ],
          "allow_extra": false
        }
      }
    ],
    "skippable_dependencies": []
  },
  "inputs": {
    "motore": {
      "bin": "codex",
      "args": [
        "exec",
        "-s",
        "workspace-write",
        "-c",
        "sandbox_workspace_write={network_access=true}",
        "Nella cartella ~/.claude/state/plancia/segnalazioni conta i file .md che non hanno una riga che inizia con 'destinatario:'. Usa grep, non leggere i file per intero. Poi elenca al massimo i 20 piu' recenti fra quelli, uno per riga, nella forma 'senza destinatario: <nome del file>'. Chiudi con una riga esatta: senza_destinatario: N"
      ],
      "env": {},
      "timeout_secs": 300
    }
  }
}
