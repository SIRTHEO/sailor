        "action": "external_engine",
        "max_attempts": 1,
        "when": null,
        "with": {
          "tool": "claude-code",
          "args": [
            "-p",
            "--model",
            "opus"
          ],
          "timeout_secs": 1800,
          "answer_shape": {
            "type": "object",
            "properties": {
              "adopt": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "what": {
                      "type": "string"
                    },
                    "why": {
                      "type": "string"
                    },
                    "first_step": {
                      "type": "string"
                    },
                    "catches": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "what",
                    "why",
                    "first_step",
                    "catches"
                  ],
                  "allow_extra": false
                }
              },
              "reject": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "what": {
                      "type": "string"
                    },
                    "why_not": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "what",
                    "why_not"
