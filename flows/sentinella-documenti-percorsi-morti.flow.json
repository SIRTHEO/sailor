{
  "id": "sentinella-documenti-percorsi-morti",
  "description": "Lavorazione ogni-notte, peso leggero: invoca codex e poi verifica il risultato.",
  "schedule": {
    "recurrence": { "kind": "daily_at", "hour": 1, "minute": 0 },
    "weight": "light",
    "perimeter": []
  },
  "graph": {
    "steps": [
      {
        "id": "motore",
        "deps": [],
        "action": "external_engine",
        "max_attempts": 1,
        "when": null,
        "input_schema": {
          "type": "object",
          "properties": {
            "bin": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "properties": {},
              "required": [],
              "allow_extra": true
            },
            "timeout_secs": {
              "type": "number"
            }
          },
          "required": [
            "bin",
            "args",
            "env",
            "timeout_secs"
          ],
          "allow_extra": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "ok",
                "exit_error",
                "timed_out",
                "spawn_failed"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "stdout",
            "stderr"
          ],
          "allow_extra": false
        }
      },
      {
        "id": "verifica",
        "deps": [
          "motore"
        ],
        "action": "shell_check",
        "max_attempts": 1,
        "when": {
          "kind": "pointer_equals",
          "pointer": "/status",
          "value": "ok"
        },
        "with": {
          "command": "real=$(find \"$HOME/.claude\" -type f \\( -name '*.md' -o -name '*.txt' \\) -exec sh -c 'for f do bad=; for p in $(grep -oE \"~/.claude/[A-Za-z0-9._/-]+\" \"$f\" 2>/dev/null); do [ -e \"$HOME${p#\\~}\" ] || bad=1; done; [ \"$bad\" = 1 ] && printf x; done' sh {} + 2>/dev/null | wc -c | tr -d ' '); [ -n \"$real\" ] && [ \"$real\" -le 288 ]",
          "timeout_secs": 120
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "ok",
                "exit_error",
                "timed_out",
                "spawn_failed"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "timeout_secs": {
              "type": "number"
            }
          },
          "required": [
            "status",
            "stdout",
            "stderr",
            "command",
            "timeout_secs"
          ],
          "allow_extra": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "passed",
                "failed",
                "timed_out"
              ]
            }
          },
          "required": [
            "status"
          ],
          "allow_extra": false
        }
      }
    ],
    "skippable_dependencies": []
  },
  "inputs": {
    "motore": {
      "bin": "codex",
      "args": [
        "exec",
        "-s",
        "workspace-write",
        "-c",
        "sandbox_workspace_write={network_access=true}",
        "Nella cartella ~/.claude conta i file .md e .txt che nominano almeno un percorso della forma ~/.claude/... che sul disco non esiste. Usa grep e find, non leggere i file per intero. Poi elenca al massimo i 15 file peggiori, uno per riga, nella forma 'morto: <percorso del file> -> <percorso citato che non esiste>'. Chiudi con una riga esatta: doc_con_percorsi_morti: N"
      ],
      "env": {},
      "timeout_secs": 300
    }
  }
}
