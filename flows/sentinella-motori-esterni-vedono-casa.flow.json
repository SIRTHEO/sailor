{
  "id": "sentinella-motori-esterni-vedono-casa",
  "description": "Lavorazione ogni-notte, peso leggero: invoca codex e poi verifica il risultato.",
  "graph": {
    "steps": [
      {
        "id": "motore",
        "deps": [],
        "action": "external_engine",
        "max_attempts": 1,
        "when": null,
        "input_schema": {
          "type": "object",
          "properties": {
            "bin": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "properties": {},
              "required": [],
              "allow_extra": true
            },
            "timeout_secs": {
              "type": "number"
            }
          },
          "required": [
            "bin",
            "args",
            "env",
            "timeout_secs"
          ],
          "allow_extra": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "ok",
                "exit_error",
                "timed_out",
                "spawn_failed"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "stdout",
            "stderr"
          ],
          "allow_extra": false
        }
      },
      {
        "id": "verifica",
        "deps": [
          "motore"
        ],
        "action": "shell_check",
        "max_attempts": 1,
        "when": {
          "kind": "pointer_equals",
          "pointer": "/status",
          "value": "ok"
        },
        "with": {
          "command": "m=$(ls -1 \"$HOME\"/.claude/docs/AGENTS.md 2>/dev/null | wc -l | tr -d ' '); i=$(\"$HOME/.claude/bin/claude-hooks\" indice cerca \"dove si decide se un compito notturno va eseguito\" 2>/dev/null | grep -c \"notte/src/lib.rs\"); [ \"$m\" = \"1\" ] && [ \"$i\" -ge 1 ]",
          "timeout_secs": 120
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "ok",
                "exit_error",
                "timed_out",
                "spawn_failed"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "timeout_secs": {
              "type": "number"
            }
          },
          "required": [
            "status",
            "stdout",
            "stderr",
            "command",
            "timeout_secs"
          ],
          "allow_extra": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "one_of",
              "values": [
                "passed",
                "failed",
                "timed_out"
              ]
            }
          },
          "required": [
            "status"
          ],
          "allow_extra": false
        }
      }
    ],
    "skippable_dependencies": []
  },
  "inputs": {
    "motore": {
      "bin": "codex",
      "args": [
        "exec",
        "-s",
        "workspace-write",
        "-c",
        "sandbox_workspace_write={network_access=true}",
        "Verifica due cose e riporta i risultati. Primo: leggi il file AGENTS.md che trovi risalendo dalla cartella di lavoro, e dì in una riga quale cartella contiene le memorie di questo progetto. Secondo: lancia il comando ~/.claude/bin/claude-hooks indice cerca \"dove si decide se un compito notturno va eseguito o saltato\" e dì in una riga il nome del file Rust che contiene la decisione. Chiudi con una riga esatta: motori_vedono_casa: si oppure motori_vedono_casa: no"
      ],
      "env": {},
      "timeout_secs": 300
    }
  }
}
