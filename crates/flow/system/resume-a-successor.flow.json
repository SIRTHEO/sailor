{
  "id": "resume-a-successor",
  "description": "THE OTHER END OF A HANDOVER. After a clear the command line waits for a prompt, so the mandate its greeting hands to the new session would sit unread. When a session starts, this flow asks whether it is the successor that reserved a handover on this terminal; if so, once its screen is free, it types one line that sets it going, and the end of the turn that line starts is the receipt that it resumed. A session that reserved nothing is left alone; one a person already spoke to is not prompted; a screen that never comes free, or keys that cannot be delivered, leave the handover for a person, because nothing else will come back to it.",
  "inputs": {},
  "graph": {
    "steps": [
      {
        "id": "trigger",
        "deps": [],
        "action": "trigger",
        "max_attempts": 1,
        "when": null,
        "with": {
          "source": "session-event",
          "on": {
            "event": "SessionStart"
          }
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "on": {
              "type": "object",
              "properties": {},
              "required": [],
              "allow_extra": true
            }
          },
          "required": [
            "source"
          ],
          "allow_extra": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "carried": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "any"
                },
                "tree": {
                  "type": "any"
                },
                "tty": {
                  "type": "any"
                },
                "session": {
                  "type": "any"
                },
                "transcript": {
                  "type": "any"
                },
                "engine": {
                  "type": "any"
                }
              },
              "required": [],
              "allow_extra": true
            }
          },
          "required": [
            "text"
          ],
          "allow_extra": true
        }
      },
      {
        "id": "resume",
        "deps": [
          "trigger"
        ],
        "action": "resume_successor",
        "max_attempts": 1,
        "when": null,
        "with": {
          "tty": {
            "$from": "/carried/tty"
          },
          "session": {
            "$from": "/carried/session"
          },
          "line": "Carry on from the mandate you were handed at the start of this session: read the file it names, check the tree against it, then do its one next thing.",
          "patience_seconds": 120
        },
        "input_schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "allow_extra": true
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "prompted": {
              "type": "boolean"
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "prompted"
          ],
          "allow_extra": true
        }
      }
    ]
  }
}
