                  "type": "any"
                },
                "tree": {
                  "type": "any"
                },
                "tty": {
                  "type": "any"
                },
                "session": {
                  "type": "any"
                },
                "transcript": {
                  "type": "any"
                }
              },
              "required": [],
              "allow_extra": true
            }
          },
          "required": [
