{
  "name": "sailor-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "La finestra di Sailor: la tela dei flussi, i nodi e i loro agenti.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "desktop": "cargo tauri dev",
    "live": "cargo run --manifest-path ../Cargo.toml -p supervisor --bin sailor-live -- --root ..",
    "desktop:build": "cargo tauri build",
    "test": "vitest run",
    "screenshots": "tsx scripts/screenshots.ts",
    "check:canvas": "tsx scripts/check-canvas.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
