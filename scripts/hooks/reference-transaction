#!/bin/sh

[ "$1" = prepared ] || exit 0
[ "${SAILOR_ALLOW_REWRITE:-}" = 1 ] && exit 0

zero=0000000000000000000000000000000000000000
while read -r old new ref; do
    case "$ref" in
        refs/heads/matteodimattia/*|refs/heads/crew/*|refs/heads/work/*|refs/heads/main)
            [ "$old" = "$zero" ] && continue
            [ "$new" = "$zero" ] && continue
            if ! git merge-base --is-ancestor "$old" "$new"; then
                echo "Refusing to rewrite $ref; set SAILOR_ALLOW_REWRITE=1 to allow it." >&2
                exit 1
            fi
            ;;
    esac
done
